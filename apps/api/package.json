  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
